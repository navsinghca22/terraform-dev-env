# Provider cache -- large, regenerated by `terraform init`
.terraform/

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Commit it.

# State. Never commit: contains secrets in plaintext, and two copies conflict.
*.tfstate
*.tfstate.*

# Saved plan files can contain sensitive attribute values.
tfplan
*.tfplan
plan.txt

# Secrets and per-developer values.
terraform.tfvars
*.auto.tfvars
backend-*.hcl

# ...but DO commit the committed, non-secret environment files.
!dev.tfvars
!*.tfvars.example

crash.log
crash.*.log
